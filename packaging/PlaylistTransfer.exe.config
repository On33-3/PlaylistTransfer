<?xml version="1.0" encoding="utf-8"?>
<!-- The window uses .NET (pythonnet + WebView2). When the zip is downloaded with a browser and unzipped with
     Windows Explorer, every file carries the "mark of the web", and .NET Framework refuses to load an assembly
     with that mark ("An attempt was made to load an assembly from a network location..."): the app didn't open.
     This setting is .NET's own switch for trusting the app's assemblies anyway; the files are not changed.
     .NET Framework reads it because it sits next to the .exe with the same name: packaging/build.py copies it there.
     Checked on 2026-11-27: with all 155 files marked, the window opens with this file and doesn't without it. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
